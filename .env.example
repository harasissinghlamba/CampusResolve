# Django
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Database engine switch: "sqlite" for local dev, "postgres" for Supabase
DB_ENGINE=sqlite

# Supabase-hosted PostgreSQL (used when DB_ENGINE=postgres)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Supabase Storage (private bucket, backend-only credentials)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-attachments

# Attachment limits
MAX_ATTACHMENT_SIZE_MB=8
ALLOWED_ATTACHMENT_TYPES=application/pdf,image/png,image/jpeg

# Spam engine rate limits
SPAM_SUBMISSIONS_PER_HOUR=3
SPAM_SUBMISSIONS_PER_DAY=8

# Student login OTP (Phase 13, email-delivered). Console backend prints the
# "email" to your runserver terminal - zero setup needed for local testing.
# For real delivery, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# and fill in EMAIL_HOST_USER / EMAIL_HOST_PASSWORD (e.g. a Gmail App Password,
# or any SMTP provider - SendGrid, Mailgun, your college's mail server, etc).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@campusresolve.local
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
REGISTRATION_UNVERIFIED_TTL_HOURS=24

# SMS OTP (optional, Twilio). Leave blank and the "send by SMS" option never
# appears - email works on its own. Fill in all three to enable it:
#   TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN -> console.twilio.com dashboard
#   TWILIO_FROM_NUMBER -> a Twilio number you own, E.164 format e.g. +15551234567
# Trial accounts can only text numbers you've verified in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Production hardening (Phase 15) - set True only behind HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
